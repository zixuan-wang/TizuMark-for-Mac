{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "TizuMark",
  "version": "1.2.4",
  "identifier": "com.tizu.markdown",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "beforeBuildCommand": "npm run build:renderer && npm run build-frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TizuMark",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "devtools": false,
        "visible": false,
        "backgroundColor": "#f5f5f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: blob: http: https:; font-src 'self' data: blob:; media-src 'self' blob: https: data:; frame-src 'self'; connect-src 'self' ipc: tauri: blob: http: https:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "resources": {
      "../demo.md": "demo.md",
      "../assets/icon.png": "assets/icon.png"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown"
      }
    ]
  }
}
